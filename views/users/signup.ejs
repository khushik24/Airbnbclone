<% layout("/layouts/boilerplate") -%>
<div class="row mt-3" >
    <h1 class="col-6 offset-3">SignUp on Wanderlust</h1>
    <div class="col-6 offset-3">
        <form action="/signup" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
            <label for ="username" class="form-label">Username</label>
            <input id="username" name="username" placeholder="enter username" type="text" class="form-control" required>
            <div class="valid-feedback">
              Looks good!
            </div>
           </div>
            <div class="mb-3">
            <label for ="email" class="form-label">Email</label>
            <input id="email" name="email" placeholder="enter email" type="email" class="form-control" required>
            <div class="valid-feedback">
              almost done!
            </div>
           </div>
            <div class="mb-3">
            <label for ="password" class="form-label">Password</label>
            <input id="password" name="password" placeholder="enter password" type="password" class="form-control" required>
            <div class="valid-feedback">
              It is a secret!
            </div>
           </div>
           <button class="btn btn-primary">Sign Up</button>

        </form>
    </div>
</div>